# Run as: cmake -P tests/setup/test_clangd.cmake
cmake_minimum_required(VERSION 3.24)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef test_id)
get_filename_component(toolkit_source "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(test_root "${toolkit_source}/build/clangd ${test_id}")

function(run_checked)
    execute_process(COMMAND ${ARGV}
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${out}\n${err}")
    endif()
endfunction()

function(check_header database header)
    file(READ "${database}" json)
    string(JSON length LENGTH "${json}")
    math(EXPR last "${length} - 1")
    set(matches 0)
    foreach(i RANGE ${last})
        string(JSON path GET "${json}" ${i} file)
        if(path STREQUAL header)
            math(EXPR matches "${matches} + 1")
            string(JSON command GET "${json}" ${i} command)
            foreach(required IN LISTS ARGN)
                if(NOT command MATCHES "${required}")
                    message(FATAL_ERROR "Header command missing ${required}: ${command}")
                endif()
            endforeach()
            if(NOT command MATCHES "(-std=[^ ]*20|[-/]std:c\\+\\+20)")
                message(FATAL_ERROR "Header command missing C++20: ${command}")
            endif()
            if(command MATCHES "(PRODUCER_PRIVATE|OWNER_EXPORT|owner_EXPORTS)")
                message(FATAL_ERROR "Private producer definition leaked: ${command}")
            endif()
            set(header_command "${command}" PARENT_SCOPE)
        endif()
    endforeach()
    if(NOT matches EQUAL 1)
        message(FATAL_ERROR "Expected one exact command for ${header}, got ${matches}")
    endif()
endfunction()

foreach(kind IN ITEMS proof_compiled proof_interface compiled interface shared disabled no_export)
    set(source "${test_root}/${kind}/source")
    set(binary "${test_root}/${kind}/build")
    file(MAKE_DIRECTORY "${source}")
    file(COPY "${CMAKE_CURRENT_LIST_DIR}/fixtures/clangd/" DESTINATION "${source}")
    set(header "${source}/include/fixture/api.hpp")
    set(header_only OFF)
    if(kind MATCHES interface)
        set(header_only ON)
    endif()
    set(options)
    if(kind MATCHES "^proof")
        list(APPEND options -DPROOF=ON)
    elseif(kind STREQUAL shared)
        list(APPEND options -DBUILD_SHARED_LIBS=ON)
    elseif(kind STREQUAL disabled)
        list(APPEND options -DCPP_LIBRARY_ENABLE_CLANGD=OFF)
    elseif(kind STREQUAL no_export)
        list(APPEND options -DCMAKE_EXPORT_COMPILE_COMMANDS=OFF)
    endif()
    run_checked("${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -G Ninja
        "-DTOOLKIT_SOURCE=${toolkit_source}" -DCMAKE_BUILD_TYPE=Debug
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_UNITY_BUILD=ON
        "-DHEADER_ONLY=${header_only}" ${options})
    file(READ "${binary}/index-target.txt" index_target)
    if(kind STREQUAL disabled OR kind STREQUAL no_export)
        if(index_target)
            message(FATAL_ERROR "Inactive registration created an indexing target")
        endif()
        message(STATUS "PASS ${kind}: no indexing target")
        continue()
    endif()
    check_header("${binary}/compile_commands.json" "${header}" PUBLIC_CONTEXT=42 include)
    if(NOT kind MATCHES "^proof")
        check_header("${binary}/compile_commands.json"
            "${source}/include/fixture/extra.hpp" PUBLIC_CONTEXT=42 LATE_CONTEXT=61 DEPENDENCY_CONTEXT=19)
        check_header("${binary}/compile_commands.json"
            "${binary}/generated/fixture/config.hpp" PUBLIC_CONTEXT=42 LATE_CONTEXT=61 DEPENDENCY_CONTEXT=19)
        check_header("${binary}/compile_commands.json"
            "${binary}/generated/fixture/build_generated.hpp" PUBLIC_CONTEXT=42 LATE_CONTEXT=61)
        check_header("${binary}/compile_commands.json"
            "${source}/nested/include/nested/api.hpp" NESTED_CONTEXT=29)
        if(header_command MATCHES "PUBLIC_CONTEXT")
            message(FATAL_ERROR "Nested dependency used downstream context: ${header_command}")
        endif()
        file(READ "${binary}/compile_commands.json" commands)
        if(kind STREQUAL shared AND NOT commands MATCHES "OWNER_IMPORT=1")
            message(FATAL_ERROR "Shared consumer command missing import definition")
        endif()
        if(NOT header_only)
            string(JSON command_count LENGTH "${commands}")
            math(EXPR command_last "${command_count} - 1")
            set(production_count 0)
            foreach(i RANGE ${command_last})
                string(JSON path GET "${commands}" ${i} file)
                if(path STREQUAL "${source}/owner.cpp")
                    math(EXPR production_count "${production_count} + 1")
                    string(JSON command GET "${commands}" ${i} command)
                    if(NOT command MATCHES "PRODUCER_PRIVATE=1" OR command MATCHES "OWNER_IMPORT")
                        message(FATAL_ERROR "Production flags changed: ${command}")
                    endif()
                endif()
            endforeach()
            if(NOT production_count EQUAL 1)
                message(FATAL_ERROR "Production sources changed: ${production_count}")
            endif()
        endif()
    endif()
    run_checked("${CMAKE_COMMAND}" --build "${binary}")
    file(GLOB_RECURSE index_objects
        "${binary}/clangd/*.obj" "${binary}/clangd/*.o"
        "${binary}/nested/clangd/*.obj" "${binary}/nested/clangd/*.o"
        "${binary}/index/*.obj" "${binary}/index/*.o")
    if(index_objects)
        message(FATAL_ERROR "Default build compiled indexing objects: ${index_objects}")
    endif()
    if(EXISTS "${binary}/generated/fixture/build_generated.hpp")
        message(FATAL_ERROR "Default build ran indexing-only generation prerequisites")
    endif()
    if(NOT kind MATCHES "^proof")
        run_checked("${CMAKE_COMMAND}" --build "${binary}" --target generate_build_header)
    endif()
    run_checked("${CMAKE_COMMAND}" --build "${binary}" --target "${index_target}")
    if(NOT kind MATCHES "^proof")
        run_checked("${CMAKE_COMMAND}" --install "${binary}" --prefix "${binary}/installed")
        file(GLOB_RECURSE installed "${binary}/installed/*")
        foreach(path IN LISTS installed)
            file(RELATIVE_PATH installed_path "${binary}/installed" "${path}")
            if(installed_path MATCHES "(clangd|index|\\.(obj|o)$)")
                message(FATAL_ERROR "Indexing artifact installed: ${path}")
            endif()
            if(path MATCHES "\\.cmake$")
                file(READ "${path}" export_text)
                if(export_text MATCHES "_cpp_library_clangd")
                    message(FATAL_ERROR "Indexing target exported: ${path}")
                endif()
            endif()
        endforeach()
    endif()
    file(READ "${binary}/properties.txt" properties)
    if(NOT properties STREQUAL "${header}\n")
        message(FATAL_ERROR "Production source properties or FILE_SET changed: ${properties}")
    endif()
    find_program(clangd clangd)
    if(clangd)
        run_checked("${clangd}" "--check=${header}" "--compile-commands-dir=${binary}" --tweaks=)
    endif()
    message(STATUS "PASS ${kind}: exact configure-time header command, isolated properties and excluded build")
endforeach()
foreach(error_case IN ITEMS conflict missing imported executable relative)
    set(source "${test_root}/errors/${error_case}/source")
    file(MAKE_DIRECTORY "${source}")
    file(COPY "${CMAKE_CURRENT_LIST_DIR}/fixtures/clangd/" DESTINATION "${source}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}"
        -B "${test_root}/errors/${error_case}/build" -G Ninja
        "-DTOOLKIT_SOURCE=${toolkit_source}" "-DERROR_CASE=${error_case}"
        -DCPP_LIBRARY_ENABLE_CLANGD=OFF
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(result EQUAL 0 OR NOT err MATCHES "cpp_library_add_clangd_headers")
        message(FATAL_ERROR "Expected actionable registration error (${error_case}): ${out}\n${err}")
    endif()
    if(error_case STREQUAL conflict AND
        (NOT err MATCHES "owner" OR NOT err MATCHES "other" OR NOT err MATCHES "api.hpp"))
        message(FATAL_ERROR "Conflict diagnostic omitted ownership details: ${err}")
    endif()
    message(STATUS "PASS ${error_case}: registration rejected")
endforeach()
file(REMOVE_RECURSE "${test_root}")
message(STATUS "All clangd cases passed!")
