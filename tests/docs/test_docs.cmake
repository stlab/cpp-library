# Run as: cmake -P tests/docs/test_docs.cmake (requires Doxygen and Ninja).
cmake_minimum_required(VERSION 3.24)
get_filename_component(toolkit_source "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef test_id)
set(test_root "${toolkit_source}/build/docs-${test_id}")

foreach(case default tutorials no-groups extended custom layout-brief layout-override layout-review layout-review-all
    invalid-layout missing-input malformed-option
    malformed-terminal-continuation-option malformed-continuation-option multiline-option
    missing-input-value missing-option-value)
    set(source "${test_root}/${case}/source with spaces")
    set(binary "${test_root}/${case}/build with spaces")
    file(MAKE_DIRECTORY "${source}")
    file(COPY "${CMAKE_CURRENT_LIST_DIR}/fixtures/" DESTINATION "${source}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -G Ninja
        "-DTOOLKIT_SOURCE=${toolkit_source}" "-DCASE=${case}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(case MATCHES "^(missing-|malformed-|multiline-)")
        if(case STREQUAL "missing-input")
            set(expected "cpp-library: Documentation input does not exist")
        elseif(case STREQUAL "missing-input-value")
            set(expected "cpp_library_setup: DOCS_INPUTS requires a value")
        elseif(case STREQUAL "missing-option-value")
            set(expected "cpp_library_setup: DOCS_OPTIONS requires a value")
        else()
            set(expected "cpp-library: DOCS_OPTIONS requires single-line Doxygen assignments")
        endif()
        string(FIND "${out}\n${err}" "${expected}" diagnostic)
        if(result EQUAL 0 OR diagnostic LESS 0)
            message(FATAL_ERROR "${case}: Expected '${expected}':\n${out}\n${err}")
        endif()
    else()
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${case}: Configure failed:\n${out}\n${err}")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${binary}" --target docs
            RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(case STREQUAL "invalid-layout" OR case STREQUAL "layout-review")
            set(expected "custom layout.xml")
            if(case STREQUAL "layout-review")
                set(expected "User defined layout misses entry")
            endif()
            if(result EQUAL 0 OR NOT "${out}\n${err}" MATCHES "${expected}")
                message(FATAL_ERROR "${case}: Layout review did not expose '${expected}':\n${out}\n${err}")
            endif()
            message(STATUS "PASS documentation ${case}")
            continue()
        endif()
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${case}: Doxygen failed:\n${out}\n${err}")
        endif()
        if(case STREQUAL "layout-review-all")
            string(REGEX MATCHALL "User defined layout misses entry" warnings "${out}\n${err}")
            list(LENGTH warnings warning_count)
            if(warning_count LESS 2)
                message(FATAL_ERROR "${case}: Review mode did not report the inherited-entry warning list")
            endif()
        endif()
        file(READ "${binary}/html/index.html" index)
        if(case STREQUAL "default" OR case STREQUAL "tutorials" OR case STREQUAL "no-groups"
            OR case MATCHES "^layout-")
            string(FIND "${index}" "Documentation fixture" brief)
        else()
            string(FIND "${index}" "Customized documentation" brief)
            string(FIND "${index}" "Extra fixture content" page)
            if(page LESS 0)
                message(FATAL_ERROR "${case}: Additional main page is missing")
            endif()
        endif()
        if(brief LESS 0)
            message(FATAL_ERROR "${case}: Project brief is missing")
        endif()
        if(case STREQUAL "default" OR case STREQUAL "extended")
            foreach(symbol hidden extra)
                set(page "${binary}/html/structfixture_1_1${symbol}.html")
                if(case STREQUAL "extended" AND EXISTS "${page}")
                    message(FATAL_ERROR "Excluded symbol is present: ${symbol}")
                elseif(case STREQUAL "default" AND NOT EXISTS "${page}")
                    message(FATAL_ERROR "Default documentation lost a public symbol: ${symbol}")
                endif()
            endforeach()
        endif()
        if(case STREQUAL "extended")
            if(NOT EXISTS "${binary}/html/group__extra__group.html")
                message(FATAL_ERROR "Absolute input group is missing")
            endif()
        endif()
        if(case STREQUAL "custom")
            string(FIND "${index}" "Legacy configuration" legacy)
            if(legacy LESS 0)
                message(FATAL_ERROR "Custom Doxyfile compatibility was lost")
            endif()
        endif()
        file(READ "${binary}/html/menudata.js" navigation)
        if(case STREQUAL "custom")
            if(navigation MATCHES "text:\"Reference\"" OR navigation MATCHES "text:\"Index\"")
                message(FATAL_ERROR "Custom Doxyfile unexpectedly inherited the toolkit layout")
            endif()
        elseif(case STREQUAL "layout-override")
            if(NOT navigation MATCHES "Custom reference")
                message(FATAL_ERROR "DOCS_OPTIONS layout override did not affect navigation")
            endif()
        else()
            string(FIND "${navigation}" "text:\"Tutorials\"" tutorials)
            string(FIND "${navigation}" "text:\"Reference\"" reference)
            string(FIND "${navigation}" "text:\"Index\"" indexes)
            if(case STREQUAL "no-groups")
                if(tutorials LESS 0 OR NOT reference LESS 0 OR indexes LESS tutorials)
                    message(FATAL_ERROR "Ungrouped API has missing tutorials or a broken Reference link")
                endif()
            elseif(tutorials LESS 0 OR reference LESS tutorials OR indexes LESS reference)
                message(FATAL_ERROR "Default layout did not order Tutorials, Reference, Index:\n${navigation}")
            endif()
            file(READ "${binary}/html/navtreedata.js" tree)
            string(FIND "${tree}" "var NAVTREE =" tree_start)
            string(SUBSTRING "${tree}" ${tree_start} -1 tree)
            string(REGEX REPLACE "^var NAVTREE =[\r\n ]*" "" tree "${tree}")
            string(FIND "${tree}" ";" tree_end)
            string(SUBSTRING "${tree}" 0 ${tree_end} tree)
            string(JSON root_count LENGTH "${tree}" 0 2)
            set(expected_roots 3)
            if(case STREQUAL "no-groups")
                set(expected_roots 2)
            endif()
            if(NOT root_count EQUAL expected_roots)
                message(FATAL_ERROR "Class, file, or example indexes escaped the Index section")
            endif()
            if(case STREQUAL "tutorials")
                file(READ "${binary}/html/pages.html" pages)
                if(NOT pages MATCHES "Install the fixture")
                    message(FATAL_ERROR "Authored tutorial is missing from the page index")
                endif()
                string(JSON index_name GET "${tree}" 0 2 2 0)
                string(JSON index_children GET "${tree}" 0 2 2 2)
                if(NOT index_name STREQUAL "Index" OR NOT index_children MATCHES "Examples")
                    message(FATAL_ERROR "Example index is missing from the Index section")
                endif()
            endif()
            if(NOT case STREQUAL "no-groups")
                file(READ "${binary}/html/group__fixture__reference.html" group)
                string(FIND "${group}" "Layout brief fixture." brief)
                string(FIND "${group}" "Layout detailed fixture." detailed)
                string(FIND "${group}" "<table class=\"memberdecls\">" members)
                if(brief LESS 0 OR detailed LESS 0 OR members LESS detailed)
                    message(FATAL_ERROR "Group brief or description-first member layout was lost")
                endif()
            endif()
        endif()
        if(case STREQUAL "default" OR case STREQUAL "layout-brief")
            file(READ "${binary}/html/structfixture_1_1hidden.html" class)
            if(NOT class MATCHES "Internal API omitted from the extended documentation")
                message(FATAL_ERROR "Partial layout lost inherited class-page content")
            endif()
        endif()
    endif()
    message(STATUS "PASS documentation ${case}")
endforeach()

file(REMOVE_RECURSE "${test_root}")
