# Included by the dependency-mapping harness; configures real nested projects.
run_test("Dependency mappings stay within their owning project")
get_filename_component(toolkit_source "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef test_id)
set(mapping_root "${toolkit_source}/build/mapping-scope-${test_id}")
file(MAKE_DIRECTORY "${mapping_root}/source/child/helper" "${mapping_root}/source/sibling")
file(WRITE "${mapping_root}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
include("${TOOLKIT_SOURCE}/cpp-library.cmake")
cpp_library_enable_dependency_tracking()
project(parent LANGUAGES CXX)
include("${TOOLKIT_SOURCE}/cmake/cpp-library-install.cmake")
add_library(cel::parser INTERFACE IMPORTED GLOBAL)
set(CPM_PACKAGES cel-parser)
set(CPM_PACKAGE_cel-parser_VERSION 1.1.0)
add_library(parent INTERFACE)
target_link_libraries(parent INTERFACE cel::parser)
if(PARENT_OVERRIDE)
    cpp_library_map_dependency("cel::parser" "cel-parser 1.2.0 CONFIG")
endif()
_cpp_library_generate_dependencies(before parent cel)
add_subdirectory(child)
add_subdirectory(sibling)
_cpp_library_generate_dependencies(after parent cel)
if(NOT "${before}" STREQUAL "${after}")
    message(FATAL_ERROR "Nested mappings changed parent: '${before}' -> '${after}'")
endif()
_cpp_library_setup_install(NAME parent PACKAGE_NAME cel-parent VERSION 1.0.0
    NAMESPACE cel INSTALL_OPTION PARENT_INSTALL)
]=])
file(WRITE "${mapping_root}/source/child/CMakeLists.txt" [=[
project(child LANGUAGES CXX)
add_library(child INTERFACE)
target_link_libraries(child INTERFACE cel::parser)
add_subdirectory(helper)
_cpp_library_generate_dependencies(result child cel)
if(NOT result STREQUAL "find_dependency(cel-parser 1.0.2 CONFIG)")
    message(FATAL_ERROR "Child lost its project mapping: '${result}'")
endif()
_cpp_library_setup_install(NAME child PACKAGE_NAME cel-child VERSION 1.0.0
    NAMESPACE cel INSTALL_OPTION CHILD_INSTALL)
]=])
file(WRITE "${mapping_root}/source/child/helper/CMakeLists.txt" [=[
cpp_library_map_dependency("cel::parser" "cel-parser 1.0.2 CONFIG")
# Resolve a different project's target from this helper directory.
_cpp_library_generate_dependencies(result parent cel)
if(PARENT_OVERRIDE)
    set(expected "find_dependency(cel-parser 1.2.0 CONFIG)")
else()
    set(expected "find_dependency(cel-parser 1.1.0)")
endif()
if(NOT result STREQUAL expected)
    message(FATAL_ERROR "Target ownership was ignored: '${result}', expected '${expected}'")
endif()
]=])
file(WRITE "${mapping_root}/source/sibling/CMakeLists.txt" [=[
project(sibling LANGUAGES CXX)
add_library(sibling INTERFACE)
target_link_libraries(sibling INTERFACE cel::parser)
_cpp_library_generate_dependencies(result sibling cel)
if(NOT result STREQUAL "find_dependency(cel-parser 1.1.0)")
    message(FATAL_ERROR "Sibling inherited another project's mapping: '${result}'")
endif()
_cpp_library_setup_install(NAME sibling PACKAGE_NAME cel-sibling VERSION 1.0.0
    NAMESPACE cel INSTALL_OPTION SIBLING_INSTALL)
]=])
foreach(parent_override OFF ON)
    set(binary "${mapping_root}/build-${parent_override}")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        -S "${mapping_root}/source" -B "${binary}"
        "-DTOOLKIT_SOURCE=${toolkit_source}" "-DPARENT_OVERRIDE=${parent_override}"
        -DPARENT_INSTALL=ON -DCHILD_INSTALL=ON -DSIBLING_INSTALL=ON
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(STATUS "Nested mapping diagnostics:\n${out}\n${err}")
    endif()
    verify_output("${result}" "0" "Nested mapping configure (${parent_override})")
    if(result EQUAL 0)
        if(parent_override)
            set(parent_dependency "find_dependency(cel-parser 1.2.0 CONFIG)")
        else()
            set(parent_dependency "find_dependency(cel-parser 1.1.0)")
        endif()
        foreach(package parent child sibling)
            if(package STREQUAL "parent")
                set(config "${binary}/cel-parentConfig.cmake")
                set(expected "${parent_dependency}")
            elseif(package STREQUAL "child")
                set(config "${binary}/child/cel-childConfig.cmake")
                set(expected "find_dependency(cel-parser 1.0.2 CONFIG)")
            else()
                set(config "${binary}/sibling/cel-siblingConfig.cmake")
                set(expected "find_dependency(cel-parser 1.1.0)")
            endif()
            file(READ "${config}" content)
            string(REGEX MATCHALL "find_dependency\\([^\n]*\\)" actual "${content}")
            verify_output("${actual}" "${expected}" "Deferred ${package} mapping (${parent_override})")
        endforeach()
    endif()
endforeach()
file(REMOVE_RECURSE "${mapping_root}")
