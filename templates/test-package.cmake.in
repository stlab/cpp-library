# Runs a build tool; failures retain the temporary tree and report the command.
function(package_test_run)
    cmake_parse_arguments(PARSE_ARGV 0 command "" "" "")
    execute_process(COMMAND ${command_UNPARSED_ARGUMENTS} RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Package check failed (${result}): ${ARGN}\nArtifacts: ${root}")
    endif()
endfunction()

# Stages enabled rules from one configured directory, including excluded dependencies.
function(package_test_install directory)
    if(EXISTS "${directory}/cmake_install.cmake")
        package_test_run("@CMAKE_COMMAND@" ${install_args} -P "${directory}/cmake_install.cmake")
    endif()
endfunction()

